{% extends "base.html" %}
{% block content %}

<h2>Voice-Based Personality Assessment 🎙️</h2>

<div class="ai-interview-box">
  <div class="ai-agent-container">
    <div class="ai-avatar">
      <!-- InteleX Agent Logo -->
      <img src="{{ url_for('static', filename='img/InteleX_logo.png') }}" 
           class="ai-agent-photo" 
           id="agentPhoto" 
           alt="AI Agent">
      <div class="glow-ring"></div>
    </div>

    <!-- Agent's Speaking Text -->
    <div class="ai-agent-text" id="aiText">
      Loading interviewer...
    </div>
  </div>
</div>

<!-- Paragraph for Candidate to Read -->
<div class="reading-box">
  <p id="readingText">
    “I enjoy exploring new ideas, meeting people, and facing challenges that help me grow.”
  </p>
</div>

<!-- Recording Section -->
<div class="candidate-section">
  <p id="statusText">Wait for the AI to finish speaking...</p>
  <button class="btn" id="recordBtn" disabled>Start Recording</button>
</div>

<!-- Only link JS file (no inline scripts) -->
<script src="{{ url_for('static', filename='js/interview.js') }}"></script>

{% endblock %}
