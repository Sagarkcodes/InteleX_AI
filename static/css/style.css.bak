/* ===============================
   GLOBAL DARK THEME (Original InteleX+)
   =============================== */

body {
  font-family: 'Segoe UI', sans-serif;
  background-color: #0b0c0e;
  color: #D8D8DA;
  margin: 0;
  padding: 0;
  overflow-x: hidden;
}

/* ===============================
   NAVBAR
   =============================== */
.nav {
  background: linear-gradient(90deg, #030712, #0F172A);
  display: flex;
  align-items: center;
  gap: 24px;
  padding: 14px 28px;
  box-shadow: 0 2px 10px rgba(0, 255, 200, 0.05);
}

.nav a {
  color: #00E4C8;
  text-decoration: none;
  font-weight: 600;
  font-size: 16px;
  transition: 0.3s ease;
}

.nav a:hover {
  color: #00FFBF;
  text-shadow: 0 0 12px #00FFBF;
}

/* ===============================
   HOME PAGE
   =============================== */
.home-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  min-height: 80vh;
  padding: 40px 16px;
}

.logo-container {
  margin-bottom: 20px;
}

.logo {
  width: 180px;
  filter: drop-shadow(0 0 25px #00E4C8);
  animation: pulseLogo 3s ease-in-out infinite;
}

@keyframes pulseLogo {
  0%, 100% { filter: drop-shadow(0 0 20px #00E4C8); }
  50% { filter: drop-shadow(0 0 45px #00FFBF); transform: scale(1.05); }
}

h1 {
  color: #00E4C8;
  font-size: 32px;
  margin: 10px 0;
}

.tagline {
  font-size: 18px;
  color: #A8A8A8;
}

.info-box {
  max-width: 800px;
  background: #111214;
  border-radius: 16px;
  padding: 24px;
  margin-top: 24px;
  line-height: 1.6;
  box-shadow: 0 0 25px rgba(0, 255, 200, 0.05);
}

/* ===============================
   BUTTONS
   =============================== */
.btn {
  background: #00E4C8;
  color: #000;
  font-weight: 600;
  border: none;
  border-radius: 10px;
  padding: 12px 26px;
  margin-top: 20px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.btn:hover {
  background: #00FFBF;
  box-shadow: 0 0 18px #00FFBF;
  transform: translateY(-2px);
}

/* ===============================
   REGISTER / FORM PAGE
   =============================== */
.container {
  background-color: #111214;
  border-radius: 16px;
  box-shadow: 0 0 25px rgba(0, 255, 200, 0.05);
  max-width: 600px;
  margin: 60px auto;
  padding: 30px;
  text-align: center;
}

.container h2 {
  color: #00E4C8;
  margin-bottom: 20px;
}

form {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

label {
  text-align: left;
  color: #D8D8DA;
  font-weight: 500;
}

input[type="text"],
input[type="email"],
input[type="file"] {
  padding: 10px 14px;
  border: 1px solid #1E1F22;
  border-radius: 8px;
  background-color: #0f1112;
  color: #fff;
  font-size: 15px;
  transition: border 0.3s ease, box-shadow 0.3s ease;
}

input:focus {
  border: 1px solid #00E4C8;
  box-shadow: 0 0 10px rgba(0, 228, 200, 0.3);
  outline: none;
}

/* ===============================
   INTERVIEW PAGE (Left-aligned AI)
   =============================== */
.ai-interview-box {
  background-color: #111214;
  border-radius: 14px;
  padding: 22px;
  margin: 30px auto;
  max-width: 800px;
  box-shadow: 0 0 18px rgba(0, 255, 200, 0.06);
}

.ai-agent-container {
  display: flex;
  align-items: center;
  gap: 20px;
}

.ai-agent-photo {
  width: 95px;
  height: 95px;
  border-radius: 50%;
  border: 3px solid #00E4C8;
  box-shadow: 0 0 20px rgba(0, 255, 200, 0.6);
  animation: pulseGlow 3s ease-in-out infinite;
}

@keyframes pulseGlow {
  0%, 100% { box-shadow: 0 0 18px #00E4C8; }
  50% { box-shadow: 0 0 35px #00FFBF; transform: scale(1.05); }
}

.ai-agent-text {
  font-size: 18px;
  color: #00E4C8;
  flex: 1;
}

.reading-box {
  background-color: #111214;
  border-radius: 14px;
  padding: 20px;
  text-align: center;
  max-width: 700px;
  margin: 30px auto;
  box-shadow: 0 0 12px rgba(0, 255, 200, 0.08);
}

.candidate-section {
  text-align: center;
  margin-bottom: 50px;
}

/* ===============================
   ANIMATIONS
   =============================== */
.animate-fade-in {
  opacity: 0;
  animation: fadeIn 1.2s ease forwards;
}

.animate-slide-up {
  opacity: 0;
  animation: slideUp 1.2s ease forwards;
}

@keyframes fadeIn { to { opacity: 1; } }
@keyframes slideUp {
  from { transform: translateY(20px); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
