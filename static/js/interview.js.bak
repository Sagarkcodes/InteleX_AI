// ==================== INTERVIEW PAGE SCRIPT ====================

// HTML elements
const aiText = document.getElementById("aiText");
const statusText = document.getElementById("statusText");
const recordBtn = document.getElementById("recordBtn");
const agentPhoto = document.getElementById("agentPhoto");
const readingText = document.getElementById("readingText");

// Candidate info (later fetched from resume automatically)
let candidateName = "Sagar Kharade";
let candidateSkills = ["Python", "Flask", "AI", "Machine Learning"];

// Sample reading paragraphs for personality/tone analysis
const readingParagraphs = [
  "I enjoy exploring new ideas and connecting with people who inspire me to grow and learn. Each challenge teaches me something valuable about myself.",
  "Staying calm under pressure allows me to approach complex situations with focus and clarity, ensuring I deliver my best work every time.",
  "I believe that collaboration and empathy are essential to achieving meaningful goals, both in professional and personal life.",
  "Continuous learning drives my motivation. I seek opportunities to expand my knowledge and refine my abilities with every experience."
];

// ---------------- FUNCTION: SPEAK USING BROWSER VOICE ----------------
function speak(text, callback) {
  aiText.textContent = text;
  const synth = window.speechSynthesis;
  const utter = new SpeechSynthesisUtterance(text);
  utter.pitch = 1.05;
  utter.rate = 1.07;

  const voices = synth.getVoices();
  if (voices && voices.length > 0) {
    utter.voice = voices.find(v => v.lang && v.lang.includes('en')) || voices[0];
  }

  agentPhoto.classList.add("speaking");
  synth.speak(utter);

  utter.onend = () => {
    agentPhoto.classList.remove("speaking");
    if (callback) callback();
  };
}

// ---------------- FUNCTION: PLAY GREETING ----------------
function playGreeting() {
  const compliment = generateCompliment(candidateSkills);
  const greeting = `Hello ${candidateName}, welcome to InteleX. ${compliment} 
  Let's begin your voice personality assessment. Please read the paragraph displayed below clearly within one minute.`;
  
  speak(greeting, () => {
    showReadingParagraph();
    enableRecording();
  });
}

// ---------------- FUNCTION: RANDOM COMPLIMENT ----------------
function generateCompliment(skills) {
  const skill = skills[Math.floor(Math.random() * skills.length)];
  const compliments = [
    `It's great to meet someone skilled in ${skill}.`,
    `I see you have strong experience in ${skill}, that’s impressive.`,
    `Your background in ${skill} sounds interesting.`,
    `With your ${skill} expertise, this should be easy for you.`
  ];
  return compliments[Math.floor(Math.random() * compliments.length)];
}

// ---------------- FUNCTION: DISPLAY RANDOM PARAGRAPH ----------------
function showReadingParagraph() {
  const randomText = readingParagraphs[Math.floor(Math.random() * readingParagraphs.length)];
  readingText.textContent = `"${randomText}"`;
}

// ---------------- FUNCTION: ENABLE RECORDING ----------------
function enableRecording() {
  recordBtn.disabled = false;
  statusText.textContent = "You may start recording now 🎤";
}

// Initialize when voices load
window.speechSynthesis.onvoiceschanged = () => playGreeting();

// ==================== AUDIO RECORDING WITH TIMER ====================
let mediaRecorder;
let audioChunks = [];
let isRecording = false;
let timerInterval;

// Event listener for record button
recordBtn.addEventListener("click", async () => {
  if (!isRecording) startRecording();
  else stopRecording();
});

async function startRecording() {
  try {
    recordBtn.textContent = "Stop Recording";
    statusText.textContent = "Recording in progress... ⏱️ 60s remaining";
    isRecording = true;
    startTimer(60); // 1-minute timer

    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
    mediaRecorder = new MediaRecorder(stream);
    mediaRecorder.ondataavailable = (e) => audioChunks.push(e.data);
    mediaRecorder.onstop = uploadAudio;
    mediaRecorder.start();

    // Automatically stop after 60 seconds
    setTimeout(() => {
      if (isRecording) stopRecording();
    }, 60000);
  } catch (err) {
    console.error("Microphone access error:", err);
    statusText.textContent = "⚠️ Microphone access denied.";
  }
}

function stopRecording() {
  recordBtn.textContent = "Start Recording";
  statusText.textContent = "Processing your audio...";
  isRecording = false;
  clearInterval(timerInterval);
  mediaRecorder.stop();
}

// ---------------- FUNCTION: TIMER DISPLAY ----------------
function startTimer(duration) {
  let timeLeft = duration;
  timerInterval = setInterval(() => {
    timeLeft--;
    statusText.textContent = `Recording in progress... ⏱️ ${timeLeft}s remaining`;
    if (timeLeft <= 0) clearInterval(timerInterval);
  }, 1000);
}

// ---------------- FUNCTION: UPLOAD AUDIO ----------------
function uploadAudio() {
  const audioBlob = new Blob(audioChunks, { type: "audio/webm" });
  audioChunks = [];
  const formData = new FormData();
  formData.append("audio", audioBlob);

  fetch("/upload-audio", { method: "POST", body: formData })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        statusText.textContent = "✅ Audio saved successfully!";
      } else {
        statusText.textContent = "⚠️ Upload failed.";
      }
    })
    .catch(() => {
      statusText.textContent = "⚠️ Error uploading.";
    });
}
